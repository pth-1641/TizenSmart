<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lb_search_frame"
    android:layout_width="match_parent"
    android:layout_height="366dp"
    android:orientation="vertical"
    android:clipChildren="false"
    android:paddingTop="12dp"
    android:paddingBottom="64dp">

    <!-- search bar on top (mic + search + sort settings) -->
    <androidx.leanback.widget.SearchBar
        android:id="@+id/lb_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- TizenTube-like channel info -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/channel_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/channel_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="560dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/channel_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/channel_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxWidth="480dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false">

        <TextView
            android:id="@+id/channel_mix"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/channel_pill_bg"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/play_mix"
            android:textColor="@color/channel_pill_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/channel_subscribe"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/channel_pill_bg"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/channel_pill_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/channel_pin"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/channel_pill_bg"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/channel_pill_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
