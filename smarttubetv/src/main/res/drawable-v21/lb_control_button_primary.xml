<?xml version="1.0" encoding="utf-8"?>
<!-- TizenTube-like: dark translucent round button, brighter when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:constantSize="true">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#B3FFFFFF" />
            <size android:width="@dimen/lb_control_button_diameter" android:height="@dimen/lb_control_button_diameter" />
            <stroke android:width="1dp" android:color="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
            <size android:width="@dimen/lb_control_button_diameter" android:height="@dimen/lb_control_button_diameter" />
            <stroke android:width="1dp" android:color="#00FFFFFF" />
        </shape>
    </item>
</selector>
